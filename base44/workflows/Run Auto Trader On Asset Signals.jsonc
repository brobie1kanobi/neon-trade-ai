{
  "name": "Run Auto Trader On Asset Signals",
  "description": "Runs the auto trader immediately when actionable asset signals are created or updated",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "AssetSignal"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "run_auto_trader_on_asset_signals",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runAutoTrader",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "runAutoTrader"
  }
}